<view style="{{appearanceStyle}}" class="container theme-{{currentTheme}}">
  <view class="logo-box">
    <!-- Logo Icon -->
    <view class="logo-icon">
      <image src="/public/images/logo.png" mode="aspectFit" class="logo-img"></image>
    </view>
    <view class="title">粤语随手查</view>
    <view class="info">
      如您尚未注册，请先阅读并勾选同意《用户协议》和《隐私政策》，完成后系统将为您开通服务账号。
    </view>
  </view>
  <view class="login-box">
    <button class="login-btn" type="primary" bindtap="handleLogin" loading="{{loading}}">
      微信一键登录
    </button>
    <button class="login-btn" type="primary" bindtap="handlePhoneLogin">
      手机号登录
    </button>
    <button class="guest-login-btn ds-action-button ds-action-button--secondary" bindtap="onCancelLogin">暂不登录，继续浏览</button>
    <view class="login-hint">
      <view class="agreement-group">
        <t-checkbox block="{{false}}" borderless="{{true}}" icon="rectangle" bind:change="onAgreementChange" value="agreed" checked="{{agreedToTerms}}" class="agreement-checkbox" style="transform: scale(0.7)" />
        我已阅读并同意Dimsum<text class="agreement-link" bind:tap="goToTerms">《用户服务协议》</text>
        <text class="agreement-text">和</text>
        <text class="agreement-link" bind:tap="goToPrivacy">《隐私政策》</text>
      </view>
    </view>
    <view class="login-hint">Version: {{version}}</view>
  </view>

  <!-- 手机号登录弹窗 -->
  <t-popup t-class="app-themed-bottom-popup theme-{{currentTheme}}" visible="{{showPhonePopup}}" placement="bottom" bind:visible-change="onPopupClose"
    close-on-overlay-click="{{true}}" rounded="{{true}}">
    <view class="phone-login-popup theme-{{currentTheme}}">
      <view class="popup-header">
        <view class="popup-title">手机号登录</view>
      </view>

      <view class="popup-content">
        <!-- 手机号输入 -->
        <view class="input-group">
          <t-input borderless="{{true}}" placeholder="请输入手机号" value="{{phone}}" bind:change="onPhoneChange" type="number" maxlength="11"
            clearable="{{true}}" />
        </view>

        <!-- 验证码输入 -->
        <view class="input-group">
          <view class="code-input-row">
            <t-input borderless="{{true}}" class="code-input" placeholder="请输入验证码" value="{{code}}" bind:change="onCodeChange" type="number"
              maxlength="6" clearable="{{true}}" />
            <t-button class="send-code-btn" theme="primary" shape="round" size="medium" variant="outline" bind:tap="sendCode"
              disabled="{{counting || !phone}}" loading="{{sendingCode}}">
              <t-count-down wx:if="{{counting}}" time="{{60000}}" format="ss秒" bind:finish="onCountDownFinish" />
              <text wx:else>{{codeButtonText}}</text>
            </t-button>
          </view>
        </view>

        <!-- 协议复选框 -->
        <view class="agreement-box">
          <view class="agreement-group">
            <label class="agreement-label">
              <t-checkbox block="{{false}}" borderless="{{true}}" icon="rectangle" bind:change="onAgreementChange" value="agreed" checked="{{agreedToTerms}}" class="agreement-checkbox" />
              <text class="agreement-text">我已阅读并同意</text>
              <text class="agreement-link" bind:tap="goToTerms">《用户服务协议》</text>
              <text class="agreement-text">和</text>
              <text class="agreement-link" bind:tap="goToPrivacy">《隐私政策》</text>
            </label>
          </view>
        </view>
      </view>

      <view class="popup-footer">
        <t-button class="login-btn" theme="primary" size="large" bind:tap="confirmPhoneLogin"
          disabled="{{!phone || !code || !agreedToTerms}}" loading="{{logining}}">
          登录
        </t-button>
      </view>
    </view>
  </t-popup>
</view>
<common-dialog id="common-dialog" />
