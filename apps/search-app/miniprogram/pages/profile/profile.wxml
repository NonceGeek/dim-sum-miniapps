<view style="{{appearanceStyle}}" class="ds-page"><scroll-view class="profile-scroll" scroll-y enhanced show-scrollbar="{{false}}"><view class="profile-content">
<view class="profile-header"><image wx:if="{{isLoggedIn && avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill" /><view wx:else class="avatar" role="button" aria-label="登录" bindtap="onAvatarTap">{{avatarText}}</view><view class="profile-identity"><view class="profile-name-row"><text class="profile-name">{{displayName}}</text></view><text wx:if="{{!isLoggedIn}}" class="subtitle">无需登录也可查粤语</text></view><button wx:if="{{!isLoggedIn}}" class="profile-login" size="mini" bindtap="onAvatarTap">登录</button><image class="profile-watermark" src="/public/images/logo.png" mode="aspectFit" aria-hidden="true" /></view>
<view wx:if="{{isLoggedIn}}" class="stats"><view class="stat"><text class="stat-value">{{historyCount}}</text><text class="stat-label">最近查询</text></view></view>
<view class="menu-list"><button wx:for="{{menuItems}}" wx:key="key" wx:if="{{item.key !== 'history' || isLoggedIn}}" class="menu-row" hover-class="none" data-key="{{item.key}}" bindtap="onMenuTap"><view class="menu-left"><view class="menu-icon menu-icon--{{item.key}} {{item.key === 'appearance' && appearanceTheme === 'dark' ? 'menu-icon--moon' : ''}}"><t-icon name="{{item.key === 'appearance' ? (appearanceTheme === 'dark' ? 'moon' : 'sunny') : item.icon}}" size="40rpx" /></view><text>{{item.title}}</text></view><view class="menu-right"><text>{{item.key === 'history' ? historyCount + ' 条' : item.key === 'appearance' ? appearanceLabel : item.hint}}</text><t-icon name="chevron-right" size="26rpx" /></view></button></view>
<button class="clear-cache" hover-class="none" bindtap="onClearCache"><t-icon name="delete" size="24rpx" /><text>清理临时缓存</text></button><text class="storage-note">收藏和查询记录仅保存在当前设备。</text><text class="version-note">Version: {{version}}</text><view wx:if="{{isLoggedIn}}" class="logout-section"><t-button theme="danger" variant="light" size="large" block bind:tap="onLogoutTap" t-class="logout-btn">退出登录</t-button></view></view></scroll-view>
<view wx:if="{{activePopup}}" class="profile-popup-mask" catchtap="closePopup">
  <view class="profile-popup" catchtap="onPopupContentTap">
    <view class="profile-popup-handle"></view>
    <view class="profile-popup-header">
      <text class="profile-popup-title">{{activePopup === 'about' ? '粤语随手查' : '问题反馈'}}</text>
      <view class="profile-popup-close" role="button" aria-label="关闭弹框" catchtap="closePopup"><t-icon name="close" size="32rpx" /></view>
    </view>
    <view wx:if="{{activePopup === 'about'}}" class="profile-popup-body">
      <text class="about-tagline">查一句，学一句。</text>
      <text class="about-description">查表达、听发音、看例句。</text>
      <text class="about-support">由点心 AI 提供支持</text>
    </view>
    <view wx:else class="profile-popup-body">
      <text class="feedback-label">请选择问题类型</text>
      <view class="feedback-types">
        <view wx:for="{{feedbackTypes}}" wx:key="*this" class="feedback-type {{feedbackTypeIndex === index ? 'feedback-type--active' : ''}}" data-index="{{index}}" bindtap="onFeedbackTypeTap">{{item}}</view>
      </view>
      <textarea class="feedback-input" value="{{feedbackText}}" placeholder="描述问题，最多 300 字" maxlength="300" disabled="{{feedbackSubmitting}}" bindinput="onFeedbackInput" />
      <button class="feedback-save" disabled="{{feedbackSubmitting}}" loading="{{feedbackSubmitting}}" bindtap="onFeedbackSave">{{feedbackSubmitting ? '提交中…' : '提交反馈'}}</button>
    </view>
  </view>
</view>
  <common-dialog id="common-dialog" theme="{{appearanceLabel === '深色' ? 'dark' : appearanceLabel === '浅色' ? 'light' : ''}}" theme-style="{{dialogTheme}}" />
  <t-action-sheet t-class="theme-sheet theme-sheet-{{appearanceTheme}}" visible="{{themeSheetVisible}}" items="{{themeOptions}}" bind:selected="onThemeSelect" bind:cancel="onThemeSheetClose" bind:close="onThemeSheetClose" />
</view>
