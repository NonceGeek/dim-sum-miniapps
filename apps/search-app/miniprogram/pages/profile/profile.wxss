.profile-scroll{height:calc(100vh - 112rpx - env(safe-area-inset-bottom))}.profile-content{padding:52rpx 32rpx 64rpx}.profile-header{display:flex;align-items:center;gap:22rpx;margin-bottom:36rpx}.avatar{width:84rpx;height:84rpx;flex:none;border-radius:24rpx;display:flex;align-items:center;justify-content:center;background:var(--ds-primary-container);color:var(--ds-on-primary);font-size:36rpx;font-weight:700;box-shadow:0 6rpx 16rpx var(--ds-primary-20)}.profile-name{display:block;font-size:32rpx;line-height:44rpx;font-weight:700}.subtitle{display:block;color:var(--ds-outline);font-size:24rpx;line-height:34rpx;margin-top:6rpx}.stats{display:flex;background:var(--ds-surface);border:2rpx solid var(--ds-home-border);border-radius:28rpx;padding:32rpx 0;margin-bottom:30rpx}.stat{flex:1;display:flex;flex-direction:column;gap:10rpx;padding-left:42rpx}.stat+.stat{border-left:2rpx solid var(--ds-border)}.stat-value{font-size:36rpx;line-height:46rpx;font-weight:700;color:var(--ds-home-blue)}.stat-label{font-size:24rpx;color:var(--ds-text-variant)}.menu-list{border:1rpx solid var(--ds-surface-low);border-radius:32rpx;background:var(--ds-surface);overflow:hidden;box-shadow:0 3rpx 10rpx var(--ds-black-4)}.menu-row{width:100%;margin:0;padding:28rpx 30rpx;display:flex;align-items:center;justify-content:space-between;min-height:132rpx;color:var(--ds-text);font-size:28rpx;font-weight:600;border-radius:0}.menu-row+.menu-row{border-top:1rpx solid var(--ds-surface-low)}.menu-left,.menu-right{display:flex;align-items:center;gap:24rpx}.menu-icon{flex:none;width:76rpx;height:76rpx;border-radius:24rpx;display:flex;align-items:center;justify-content:center;color:var(--ds-primary);background:var(--ds-home-blue-soft)}.menu-right{color:var(--ds-outline);font-size:24rpx;font-weight:400;gap:8rpx}.clear-cache{display:flex;align-items:center;justify-content:center;gap:12rpx;color:var(--ds-outline);font-size:24rpx;width:auto;margin:36rpx 0 24rpx;padding:20rpx}.storage-note{display:block;text-align:center;font-size:24rpx;line-height:32rpx;color:var(--ds-outline)}.profile-content .menu-list .menu-row{width:100%;max-width:none;margin:0;box-sizing:border-box;text-align:left}.menu-left{min-width:0;flex:1}.menu-right{flex:none}.profile-content .clear-cache{width:auto;max-width:none}

.profile-header{position:relative;padding-right:120rpx}.profile-watermark{position:absolute;right:-12rpx;top:50%;transform:translateY(-50%);width:140rpx;height:140rpx;opacity:.12;pointer-events:none}
.profile-content .profile-header{min-height:144rpx;padding:24rpx 148rpx 24rpx 28rpx;margin-bottom:32rpx;border:2rpx solid var(--ds-home-border);border-radius:28rpx;background:var(--ds-surface);box-shadow:0 4rpx 12rpx var(--ds-black-4);overflow:hidden}.profile-header .profile-watermark{right:-10rpx;width:152rpx;height:152rpx}.profile-header .profile-name{font-size:32rpx;white-space:nowrap}.profile-header .subtitle{font-size:24rpx;white-space:nowrap}.profile-header .avatar{width:80rpx;height:80rpx}

.version-note{display:block;text-align:center;font-size:24rpx;line-height:30rpx;color:var(--ds-outline);margin-top:12rpx}.logout-section{width:100%;margin-top:28rpx;--td-button-large-height:100rpx}.logout-section t-button{display:block;width:100%}.logout-btn{width:100% !important;min-width:100%;height:100rpx;border-radius:999rpx !important}

.profile-popup-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  background: var(--ds-black-60);
}

.profile-popup {
  position: relative;
  width: 100%;
  max-height: 82vh;
  padding: 20rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  border-radius: 40rpx 40rpx 0 0;
  border: 2rpx solid var(--ds-home-border);
  background: var(--ds-surface);
  color: var(--ds-text);
  box-shadow: 0 -12rpx 40rpx var(--ds-black-12);
}

.profile-popup-handle {
  width: 64rpx;
  height: 8rpx;
  margin: 0 auto 32rpx;
  border-radius: 8rpx;
  background: var(--ds-outline);
  opacity: 0.5;
}

.profile-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.profile-popup-title {
  font-size: 36rpx;
  line-height: 48rpx;
  font-weight: 700;
}

.profile-popup-close {
  flex: none;
  margin-left: auto;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--ds-border);
  border-radius: 999rpx;
  background: var(--ds-surface);
  color: var(--ds-text-secondary);
}

.profile-popup-body {
  padding-top: 36rpx;
}

.about-tagline,
.about-description,
.about-support,
.feedback-label {
  display: block;
}

.about-tagline {
  font-size: 32rpx;
  font-weight: 600;
}

.about-description {
  margin-top: 24rpx;
  color: var(--ds-text-variant);
  font-size: 28rpx;
  line-height: 44rpx;
}

.about-support {
  margin-top: 48rpx;
  color: var(--ds-primary);
  font-size: 26rpx;
}

.feedback-label {
  margin-bottom: 20rpx;
  color: var(--ds-text-variant);
  font-size: 26rpx;
}

.feedback-input {
  width: 100%;
  border: 2rpx solid var(--ds-home-border);
  border-radius: 20rpx;
  background: var(--ds-bg);
  color: var(--ds-text);
  font-size: 26rpx;
}

.feedback-types {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.feedback-type {
  width: calc(50% - 8rpx);
  min-height: 72rpx;
  padding: 12rpx 20rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid var(--ds-home-border);
  border-radius: 18rpx;
  background: var(--ds-bg);
  color: var(--ds-text-variant);
  font-size: 26rpx;
}

.feedback-type--active {
  border-color: var(--ds-primary);
  background: var(--ds-home-blue-soft);
  color: var(--ds-primary);
  font-weight: 600;
}

.feedback-input {
  box-sizing: border-box;
  height: 160rpx;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  line-height: 42rpx;
}

.feedback-save {
  margin: 30rpx 0 0;
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  color: var(--ds-on-primary);
  background: var(--ds-primary-container);
  font-size: 28rpx;
  font-weight: 600;
}





.profile-identity{flex:1;min-width:0}
.profile-name-row{display:flex;align-items:center;gap:16rpx}
.profile-content .profile-header .profile-login{position:absolute;right:28rpx;top:50%;transform:translateY(-50%);z-index:1;flex:none;width:120rpx;min-width:120rpx;max-width:120rpx;height:68rpx;margin:0;padding:0;display:flex;align-items:center;justify-content:center;border-radius:34rpx;background:var(--ds-home-blue-soft);color:var(--ds-home-blue);font-size:28rpx;font-weight:600;line-height:1}

.menu-icon--history{background:#d2e5ff;color:#245de4}
.menu-icon--appearance{background:#ffeba0;color:#ba6510}
.menu-icon--feedback{background:#baf3dc;color:#10836a}
.menu-icon--about{background:#e7dfff;color:#7353c7}
@media (prefers-color-scheme: dark){
  .menu-icon--history{background:#21395d;color:#94baff}
  .menu-icon--appearance{background:#4c3b20;color:#f4cd76}
  .menu-icon--feedback{background:#1e443b;color:#86dec0}
  .menu-icon--about{background:#383052;color:#c5afff}
}
