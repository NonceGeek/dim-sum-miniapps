<view style="{{appearanceStyle}}" class="quiz-page ds-page">
  <view wx:if="{{loading}}" class="quiz-state">正在获取题目…</view>
  <view wx:elif="{{error}}" class="quiz-state"><text>{{error}}</text><t-button block theme="primary" shape="round" bindtap="onRetryTap">重试</t-button></view>
  <view wx:elif="{{finished}}" class="quiz-state quiz-summary">
    <view class="quiz-summary__icon"><t-icon name="check" size="56rpx" /></view>
    <text class="quiz-summary__title">完成练习</text>
    <text class="quiz-summary__score">答对 {{correctCount}} / {{questions.length}} 题</text>
    <t-button block theme="primary" shape="round" size="large" bindtap="onRetryTap">再练一组</t-button>
  </view>
  <block wx:else>
    <view class="progress-section">
      <text class="progress-text">第 {{currentIndex + 1}} 题 / 共 {{questions.length}} 题</text>
      <view class="progress-row"><view class="progress-track"><view class="progress-fill" style="width:{{progressPercent}}%" /></view><text class="progress-percent">{{progressPercent}}%</text></view>
    </view>
    <view class="count-down {{secondsLeft <= 5 && !answerShown ? 'count-down--urgent' : ''}}">
      <view class="hourglass {{!answerShown ? 'hourglass--flipping' : ''}}"><t-icon name="hourglass" size="40rpx" /></view><text class="count-down-number">{{secondsLeft < 10 ? '0' : ''}}{{secondsLeft}}</text><text class="count-down-suffix">s</text>
    </view>
    <view class="dialogue-card">
      <text class="scene-title">场景：{{currentQuestion.scenario}}</text>
      <view class="dialogue-bubble"><text>{{currentQuestion.stemPre}}</text><text class="quiz-blank">{{answerShown ? currentQuestion.options[currentQuestion.answerIndex].text : '____'}}</text><text>{{currentQuestion.stemPost}}</text></view>
    </view>
    <view class="quiz-options">
      <view wx:for="{{currentQuestion.options}}" wx:key="text" class="quiz-option {{answerShown && index === currentQuestion.answerIndex ? 'quiz-option--correct' : ''}} {{answerShown && index === selectedIndex && index !== currentQuestion.answerIndex ? 'quiz-option--wrong' : ''}}" hover-class="quiz-option--pressed" data-index="{{index}}" bindtap="onOptionTap">
        <view class="option-letter">{{optionLetters[index]}}</view>
        <view class="option-copy"><text class="option-text">{{item.text}}</text><text class="option-pronunciation">{{item.pronunciation}}</text></view>
        <t-icon wx:if="{{answerShown && (index === currentQuestion.answerIndex || index === selectedIndex)}}" name="{{index === currentQuestion.answerIndex ? 'check-circle-filled' : 'close-circle-filled'}}" size="36rpx" custom-class="option-state" />
      </view>
    </view>
  </block>
  <common-dialog id="common-dialog" theme="{{appearanceLabel === '深色' ? 'dark' : appearanceLabel === '浅色' ? 'light' : ''}}" theme-style="{{dialogTheme}}" />
</view>
