.page { height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
.search-header { flex: none; z-index: 10; padding: 24rpx 32rpx 20rpx; background: var(--ds-bg); }
.search-clear { flex: none; display: flex; align-items: center; justify-content: center; width: 32rpx; height: 64rpx; }
.result-scroll { flex: 1; height: 0; min-height: 0; width: 100%; box-sizing: border-box; }
.section { margin: 28rpx 32rpx 36rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; margin: 0 4rpx 20rpx; }
.section-head__title { color: var(--ds-text); font-size: 28rpx; line-height: 40rpx; font-weight: 600; }
.section-count { font-size: 24rpx; color: var(--ds-outline); }
.entry-card { padding: 28rpx; border-radius: 28rpx; overflow: hidden; box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, .025); }
.entry-card + .entry-card { margin-top: 20rpx; }
.entry-card__top { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.entry-card__word { flex: 1; min-width: 0; font-size: 36rpx; font-weight: 700; line-height: 52rpx; color: var(--ds-text); overflow-wrap: break-word; }
.entry-card__body { padding-top: 12rpx; color: var(--ds-text); font-size: 28rpx; line-height: 44rpx; }
.entry-card__body + .entry-card__body { border-top: 1rpx solid var(--ds-border); margin-top: 24rpx; padding-top: 24rpx; }
.sense-reading { display: flex; align-items: center; gap: 12rpx; justify-content: flex-start; margin-bottom: 12rpx; }
.sense-reading:empty { display: none; }
.entry-card__phonetic { display: block; min-width: 0; color: var(--ds-text-secondary); font-size: 26rpx; line-height: 38rpx; overflow-wrap: break-word; }
.sense-meaning { display: block; }
.entry-card__grid { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid var(--ds-border); }
.entry-card__tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.entry-tag { color: var(--ds-outline); font-size: 24rpx; line-height: 32rpx; }
.empty-state { padding: 100rpx 40rpx; text-align: center; }
.empty-state__text { display: block; color: var(--ds-text-secondary); font-size: 28rpx; line-height: 44rpx; }
.result-hint { padding: 24rpx 32rpx; text-align: center; color: var(--ds-outline); font-size: 26rpx; line-height: 40rpx; }
.result-bottom-space { height: calc(160rpx + env(safe-area-inset-bottom)); }


.section--related .entry-card__word { font-size: 32rpx; line-height: 46rpx; font-weight: 600; }

/* Search card: expression → pronunciation → meaning → context. */
.section { margin-top: 20rpx; }
.section-head { margin-bottom: 22rpx; }
.section-head__title { padding-left: 16rpx; border-left: 6rpx solid var(--ds-primary); color: var(--ds-primary); font-size: 28rpx; line-height: 34rpx; }
.entry-card { padding: 32rpx; border-radius: 32rpx; border-color: transparent; box-shadow: 0 6rpx 26rpx rgba(32, 52, 92, .035); }
.entry-card__top { margin-bottom: 20rpx; }
.entry-card__word { font-size: 36rpx; line-height: 52rpx; }
.entry-card__body { padding-top: 0; }
.sense-reading { gap: 18rpx; margin-bottom: 22rpx; flex-wrap: wrap; }
.entry-card__phonetic { color: var(--ds-text-secondary); font-size: 28rpx; line-height: 40rpx; }
.sense-meaning { font-size: 28rpx; line-height: 46rpx; }
.entry-card__grid { margin-top: 28rpx; padding-top: 24rpx; border-top-style: dashed; }
.scene-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 24rpx; }
.scene-tag { padding: 4rpx 14rpx; border: 1rpx solid transparent; border-radius: 10rpx; background: var(--ds-surface-low); color: var(--ds-text-secondary); font-size: 24rpx; line-height: 34rpx; }
.scene-tag--primary { background: var(--ds-home-blue-soft); border-color: var(--ds-border); color: var(--ds-primary); }

/* Demo-inspired layout with the existing app palette. */
.entry-card { position: relative; padding: 32rpx; border: 1rpx solid var(--ds-border); border-radius: 28rpx; box-shadow: none; }
.entry-card__top { align-items: center; min-height: 52rpx; margin-bottom: 12rpx; }
.page button.entry-play { flex: none; display: flex !important; align-items: center; justify-content: center; width: 76rpx !important; min-width: 76rpx; height: 76rpx; margin: 0; padding: 0; border-radius: 50%; background: var(--ds-home-blue-soft); color: var(--ds-primary); }
.sense-reading { margin-bottom: 26rpx; }
.entry-card__phonetic { color: var(--ds-text-secondary); font-size: 26rpx; line-height: 38rpx; }
.sense-meaning { padding-left: 22rpx; border-left: 4rpx solid var(--ds-primary); color: var(--ds-text-secondary); font-size: 28rpx; line-height: 44rpx; }
.entry-card__footer { display: flex; align-items: flex-start; gap: 16rpx; margin-top: 28rpx; padding-top: 20rpx; border-top: 1rpx solid var(--ds-border); }
.entry-card__footer .entry-card__grid { flex: 1; min-width: 0; margin: 0; padding: 0; border: 0; }

.page .empty-state button.retry-button { display: inline-flex !important; align-items: center; justify-content: center; gap: 12rpx; width: auto !important; min-width: 208rpx; height: 76rpx; padding: 0 28rpx; margin: 28rpx auto 0; border-radius: 38rpx; background: var(--ds-home-blue-soft); color: var(--ds-primary); font-size: 28rpx; font-weight: 600; line-height: 40rpx; }
.retry-button--pressed { opacity: .7; }

.entry-card--sentence { padding: 36rpx 32rpx; }
.entry-card--sentence .entry-card__top { margin-bottom: 24rpx; }
.entry-card--sentence .entry-card__word { font-size: 28rpx; line-height: 46rpx; font-weight: 600; }
.entry-card--sentence .sense-reading { margin-bottom: 30rpx; }
.entry-card--sentence .entry-card__phonetic { font-size: 26rpx; line-height: 42rpx; }
.entry-card--sentence .sense-meaning { line-height: 46rpx; }
.entry-card--sentence .entry-card__footer { margin-top: 32rpx; padding-top: 24rpx; }

.usage-link { display: inline-flex; align-items: center; gap: 18rpx; margin-top: 24rpx; min-height: 48rpx; color: var(--ds-primary); font-size: 28rpx; line-height: 40rpx; font-weight: 500; }

.entry-media { margin-top: 24rpx; overflow: hidden; border-radius: 20rpx; }
.entry-media video, .entry-media image { display: block; width: 100%; }
.entry-media video { height: 340rpx; }

.entry-tag-groups { margin-top: 24rpx; }
.entry-tag-groups .scene-tags { margin-top: 0; }
.entry-tag-groups .scene-tags + .scene-tags { margin-top: 20rpx; }

.entry-meta-row { display: flex; align-items: flex-start; gap: 24rpx; font-size: 24rpx; line-height: 38rpx; }
.entry-meta-row + .entry-meta-row { margin-top: 12rpx; }
.entry-meta-label { flex: 0 0 144rpx; color: var(--ds-outline); }
.entry-meta-value { flex: 1; min-width: 0; text-align: right; color: var(--ds-text-secondary); overflow-wrap: break-word; }

.page button.section-refresh { display: inline-flex !important; align-items: center; justify-content: center; gap: 8rpx; width: auto !important; margin: 0; padding: 8rpx 0 8rpx 16rpx; background: transparent; color: var(--ds-text-secondary); font-size: 24rpx; line-height: 36rpx; }
.page button.section-refresh[disabled] { opacity: .4; }
.media-filter-scroll { width: 100%; margin: 0 0 24rpx; white-space: nowrap; }
.media-filter-list { display: inline-flex; align-items: center; gap: 8rpx; }
.page button.media-filter { flex: none; display: inline-flex !important; align-items: center; justify-content: center; width: auto !important; min-height: 64rpx; margin: 0; padding: 0 22rpx; border-radius: 34rpx; background: transparent; color: var(--ds-text-secondary); font-size: 26rpx; line-height: 40rpx; }
.page button.media-filter--active { background: var(--ds-home-blue-soft); color: var(--ds-primary); font-weight: 600; }


.entry-model { margin-top: 24rpx; }

.skeleton-fill{background:var(--ds-surface-low);border-radius:8rpx}.skeleton-heading{width:144rpx;height:32rpx}.skeleton-count{width:112rpx;height:26rpx}.skeleton-card{position:relative;overflow:hidden;pointer-events:none}.skeleton-top{height:50rpx;display:flex;align-items:center}.skeleton-word{width:28%;height:40rpx}.skeleton-play{position:absolute;right:32rpx;top:32rpx;width:76rpx;height:76rpx;border-radius:50%}.skeleton-reading{width:36%;height:28rpx;margin-top:16rpx}.skeleton-meaning{border-left:4rpx solid var(--ds-home-blue-soft);padding:6rpx 0 6rpx 20rpx;margin-top:28rpx}.skeleton-definition{width:55%;height:28rpx}.skeleton-label{width:112rpx;height:26rpx;flex:none}.skeleton-value{width:34%;height:26rpx}.skeleton-value--long{width:62%}.skeleton-tags{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:16rpx}.skeleton-tag{width:122rpx;height:38rpx}.skeleton-link{width:144rpx;height:30rpx;margin-top:32rpx}.skeleton-filters{display:flex;justify-content:space-between;gap:16rpx;margin:24rpx 0 30rpx}.skeleton-filter{flex:1;height:42rpx;border-radius:24rpx}.skeleton-preview{min-height:160rpx}.skeleton-card::after{content:'';position:absolute;inset:0;background:linear-gradient(100deg,transparent 20%,var(--ds-surface) 50%,transparent 80%);opacity:.45;transform:translateX(-100%);animation:search-shimmer 1.5s ease-in-out infinite}@keyframes search-shimmer{to{transform:translateX(100%)}}
