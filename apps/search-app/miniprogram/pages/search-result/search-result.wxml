<view style="{{appearanceStyle}}" class="page ds-page">
  <view class="search-header">
    <view class="search-glow {{!keyword ? 'search-glow--idle' : ''}}"><view class="search-shell">
      <t-icon name="search" size="34rpx" color="var(--ds-outline)" />
      <input class="search-native" value="{{keyword}}" placeholder="搜索粤语表达…" placeholder-class="search-placeholder" bindinput="onSearchChange" bindconfirm="onSearchSubmit" confirm-type="search" />
      <view wx:if="{{keyword}}" class="search-clear" role="button" aria-label="清空搜索" bindtap="onClearTap"><t-icon name="close" size="28rpx" color="var(--ds-outline)" /></view>
      <button class="search-submit" bindtap="onSearchSubmit">搜索</button>
    </view></view>
  </view>

  <scroll-view bindscroll="onResultScroll" class="result-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{loading}}" class="search-skeleton" aria-label="正在搜索" aria-busy="true">
      <view class="section">
        <view class="section-head"><view class="skeleton-heading skeleton-fill"></view><view class="skeleton-count skeleton-fill"></view></view>
        <view class="entry-card ds-card skeleton-card">
          <view class="skeleton-top"><view class="skeleton-word skeleton-fill"></view><view class="skeleton-play skeleton-fill"></view></view>
          <view class="skeleton-reading skeleton-fill"></view>
          <view class="skeleton-meaning"><view class="skeleton-definition skeleton-fill"></view></view>
          <view class="entry-card__footer"><view class="entry-card__grid"><view wx:for="{{[0, 1, 2]}}" wx:key="*this" class="entry-meta-row"><view class="skeleton-label skeleton-fill"></view><view class="skeleton-value skeleton-fill {{index === 0 ? 'skeleton-value--long' : ''}}"></view></view></view></view>
          <view class="entry-tag-groups"><view class="skeleton-tags"><view class="skeleton-tag skeleton-fill"></view></view><view class="skeleton-tags"><view wx:for="{{[0, 1, 2, 3, 4, 5]}}" wx:key="*this" class="skeleton-tag skeleton-fill"></view></view></view>
          <view class="skeleton-link skeleton-fill"></view>
        </view>
      </view>
      <view class="section section--related"><view class="section-head"><view class="skeleton-heading skeleton-fill"></view><view class="skeleton-count skeleton-fill"></view></view><view class="skeleton-filters"><view wx:for="{{[0, 1, 2, 3, 4, 5]}}" wx:key="*this" class="skeleton-filter skeleton-fill"></view></view><view class="entry-card ds-card skeleton-card skeleton-preview"><view class="skeleton-word skeleton-fill"></view><view class="skeleton-reading skeleton-fill"></view></view></view>
    </view>
    <view wx:elif="{{error}}" class="empty-state"><text class="empty-state__text">{{error}}</text><button class="retry-button" size="mini" hover-class="retry-button--pressed" bindtap="onRetry"><t-icon name="refresh" size="28rpx" /><text>重新加载</text></button></view>
    <block wx:else>
      <view wx:if="{{!direct.length && (related.length || recommended.length)}}" class="result-hint">未找到精准匹配，以下是相关内容</view>
      <view wx:if="{{!direct.length && !related.length && !recommended.length && (semanticStatus === 'success' || semanticStatus === 'fallback') && primaryStatus !== 'error' && !mediaType}}" class="empty-state"><text class="empty-state__text">未找到与「{{searchedKeyword}}」相关的结果</text></view>
      <view wx:if="{{direct.length}}" class="section"><view class="section-head"><text class="section-head__title">精准匹配</text><text class="section-count">已展示 {{direct.length}} 条</text></view>
        <view wx:for="{{direct}}" wx:for-item="entry" wx:key="id" class="entry-card ds-card {{entry.expression.length > 12 ? 'entry-card--sentence' : ''}}">
          <view class="entry-card__top">
            <text class="entry-card__word">{{entry.expression}}</text>
            <button wx:if="{{entry.audioUrl}}" class="entry-play" size="mini" aria-label="{{playingUrl === entry.audioUrl ? '暂停音频' : '播放音频'}}" data-url="{{entry.audioUrl}}" bindtap="onPlayAudio"><t-icon name="{{playingUrl === entry.audioUrl ? 'pause' : 'play'}}" size="36rpx" /></button>
          </view>
          <view wx:if="{{entry.jyutping || entry.meaning}}" class="entry-card__body">
            <view wx:if="{{entry.jyutping}}" class="sense-reading"><text class="entry-card__phonetic">{{entry.jyutping}}</text></view>
            <text wx:if="{{entry.meaning}}" class="sense-meaning">{{entry.meaning}}</text>
          </view>
          <view class="entry-media" wx:if="{{entry.assets.videoUrl || entry.assets.coverImage}}"><video binderror="onVideoError" wx:if="{{entry.assets.videoUrl}}" src="{{entry.assets.videoUrl}}" poster="{{entry.assets.coverImage}}" controls /><image wx:elif="{{entry.assets.coverImage}}" src="{{entry.assets.coverImage}}" mode="widthFix" data-url="{{entry.assets.coverImage}}" bindtap="onPreviewImage" /></view>
          <view wx:if="{{entry.assets.model3dUrl}}" class="entry-model"><native-model scroll-offset="{{modelScrollOffset}}" viewport-top="{{modelViewportTop}}" viewport-bottom="{{modelViewportBottom}}" id="native-{{entry.id}}" data-id="{{entry.id}}" data-url="{{entry.assets.model3dUrl}}" bindexpand="onOpenModel" src="{{entry.assets.model3dUrl}}" dark="{{appearanceTheme === 'dark'}}" /></view>
          <view class="entry-card__footer"><view class="entry-card__grid"><view class="entry-meta-row"><text class="entry-meta-label">来源语料集</text><text class="entry-meta-value">{{entry.source.datasetName}}</text></view><view wx:if="{{entry.primaryCategory}}" class="entry-meta-row"><text class="entry-meta-label">一级分类</text><text class="entry-meta-value">{{entry.primaryCategory}}</text></view><view wx:if="{{entry.secondaryCategory}}" class="entry-meta-row"><text class="entry-meta-label">二级分类</text><text class="entry-meta-value">{{entry.secondaryCategory}}</text></view></view></view>
          <view wx:if="{{entry.primaryTags.length || entry.secondaryTags.length}}" class="entry-tag-groups"><view wx:if="{{entry.primaryTags.length}}" class="scene-tags scene-tags--primary"><text wx:for="{{entry.primaryTags}}" wx:key="*this" class="scene-tag scene-tag--primary">{{item}}</text></view><view wx:if="{{entry.secondaryTags.length}}" class="scene-tags scene-tags--secondary"><text wx:for="{{entry.secondaryTags}}" wx:key="*this" class="scene-tag">{{item}}</text></view></view>
          <view wx:if="{{entry.source.licenses.length}}" class="entry-card__tags"><text wx:for="{{entry.source.licenses}}" wx:key="*this" class="entry-tag">{{item}}</text></view>
          <view class="usage-link" role="button" data-id="{{entry.id}}" bindtap="onUsageTap"><text>查看用法</text><t-icon name="arrow-right" size="28rpx" /></view>
        </view>
      </view>
      <view wx:if="{{!error && !loading}}" class="section section--related"><view class="section-head"><text class="section-head__title">相关表达</text><button class="section-refresh" disabled="{{semanticLoading || similarLoading || similarCursor === null}}" data-part="similar" data-replace="{{true}}" bindtap="onLoadMore"><t-icon name="refresh" size="28rpx" /><text>{{similarLoading ? '加载中' : '换一批'}}</text></button></view>
        <scroll-view class="media-filter-scroll" scroll-x show-scrollbar="{{false}}"><view class="media-filter-list"><button wx:for="{{mediaFilters}}" wx:key="value" class="media-filter {{mediaType === item.value ? 'media-filter--active' : ''}}" data-value="{{item.value}}" bindtap="onMediaFilterTap">{{item.label}}</button></view></scroll-view>
        <view wx:if="{{semanticLoading}}" class="result-hint">正在加载相关内容…</view>
        <view wx:elif="{{!related.length && semanticStatus !== 'error'}}" class="result-hint">{{mediaType ? '暂无该类型的相关表达' : '暂无相关表达'}}</view>
        <view wx:for="{{related}}" wx:for-item="entry" wx:key="id" class="entry-card ds-card {{entry.expression.length > 12 ? 'entry-card--sentence' : ''}}">
          <view class="entry-card__top">
            <text class="entry-card__word">{{entry.expression}}</text>
            <button wx:if="{{entry.audioUrl}}" class="entry-play" size="mini" aria-label="{{playingUrl === entry.audioUrl ? '暂停音频' : '播放音频'}}" data-url="{{entry.audioUrl}}" bindtap="onPlayAudio"><t-icon name="{{playingUrl === entry.audioUrl ? 'pause' : 'play'}}" size="36rpx" /></button>
          </view>
          <view wx:if="{{entry.jyutping || entry.meaning}}" class="entry-card__body">
            <view wx:if="{{entry.jyutping}}" class="sense-reading"><text class="entry-card__phonetic">{{entry.jyutping}}</text></view>
            <text wx:if="{{entry.meaning}}" class="sense-meaning">{{entry.meaning}}</text>
          </view>
          <view class="entry-media" wx:if="{{entry.assets.videoUrl || entry.assets.coverImage}}"><video binderror="onVideoError" wx:if="{{entry.assets.videoUrl}}" src="{{entry.assets.videoUrl}}" poster="{{entry.assets.coverImage}}" controls /><image wx:elif="{{entry.assets.coverImage}}" src="{{entry.assets.coverImage}}" mode="widthFix" data-url="{{entry.assets.coverImage}}" bindtap="onPreviewImage" /></view>
          <view wx:if="{{entry.assets.model3dUrl}}" class="entry-model"><native-model scroll-offset="{{modelScrollOffset}}" viewport-top="{{modelViewportTop}}" viewport-bottom="{{modelViewportBottom}}" id="native-{{entry.id}}" data-id="{{entry.id}}" data-url="{{entry.assets.model3dUrl}}" bindexpand="onOpenModel" src="{{entry.assets.model3dUrl}}" dark="{{appearanceTheme === 'dark'}}" /></view>
          <view class="entry-card__footer"><view class="entry-card__grid"><view class="entry-meta-row"><text class="entry-meta-label">来源语料集</text><text class="entry-meta-value">{{entry.source.datasetName}}</text></view><view wx:if="{{entry.primaryCategory}}" class="entry-meta-row"><text class="entry-meta-label">一级分类</text><text class="entry-meta-value">{{entry.primaryCategory}}</text></view><view wx:if="{{entry.secondaryCategory}}" class="entry-meta-row"><text class="entry-meta-label">二级分类</text><text class="entry-meta-value">{{entry.secondaryCategory}}</text></view></view></view>
          <view wx:if="{{entry.primaryTags.length || entry.secondaryTags.length}}" class="entry-tag-groups"><view wx:if="{{entry.primaryTags.length}}" class="scene-tags scene-tags--primary"><text wx:for="{{entry.primaryTags}}" wx:key="*this" class="scene-tag scene-tag--primary">{{item}}</text></view><view wx:if="{{entry.secondaryTags.length}}" class="scene-tags scene-tags--secondary"><text wx:for="{{entry.secondaryTags}}" wx:key="*this" class="scene-tag">{{item}}</text></view></view>
          <view wx:if="{{entry.source.licenses.length}}" class="entry-card__tags"><text wx:for="{{entry.source.licenses}}" wx:key="*this" class="entry-tag">{{item}}</text></view>
          <view class="usage-link" role="button" data-id="{{entry.id}}" bindtap="onUsageTap"><text>查看用法</text><t-icon name="arrow-right" size="28rpx" /></view>
        </view>
      </view>
      <view wx:if="{{similarLoading}}" class="result-hint">正在加载…</view>
      <view wx:elif="{{similarError}}" class="result-hint" data-part="similar" bindtap="onLoadMore">{{similarError}}</view>
      <view wx:if="{{recommended.length}}" class="section section--related"><view class="section-head"><text class="section-head__title">继续探索</text><button class="section-refresh" disabled="{{recommendedLoading || recommendedCursor === null}}" data-part="recommended" data-replace="{{true}}" bindtap="onLoadMore"><t-icon name="refresh" size="28rpx" /><text>{{recommendedLoading ? '加载中' : '换一批'}}</text></button></view>
        <view wx:for="{{recommended}}" wx:for-item="entry" wx:key="id" class="entry-card ds-card {{entry.expression.length > 12 ? 'entry-card--sentence' : ''}}">
          <view class="entry-card__top">
            <text class="entry-card__word">{{entry.expression}}</text>
            <button wx:if="{{entry.audioUrl}}" class="entry-play" size="mini" aria-label="{{playingUrl === entry.audioUrl ? '暂停音频' : '播放音频'}}" data-url="{{entry.audioUrl}}" bindtap="onPlayAudio"><t-icon name="{{playingUrl === entry.audioUrl ? 'pause' : 'play'}}" size="36rpx" /></button>
          </view>
          <view wx:if="{{entry.jyutping || entry.meaning}}" class="entry-card__body">
            <view wx:if="{{entry.jyutping}}" class="sense-reading"><text class="entry-card__phonetic">{{entry.jyutping}}</text></view>
            <text wx:if="{{entry.meaning}}" class="sense-meaning">{{entry.meaning}}</text>
          </view>
          <view class="entry-media" wx:if="{{entry.assets.videoUrl || entry.assets.coverImage}}"><video binderror="onVideoError" wx:if="{{entry.assets.videoUrl}}" src="{{entry.assets.videoUrl}}" poster="{{entry.assets.coverImage}}" controls /><image wx:elif="{{entry.assets.coverImage}}" src="{{entry.assets.coverImage}}" mode="widthFix" data-url="{{entry.assets.coverImage}}" bindtap="onPreviewImage" /></view>
          <view wx:if="{{entry.assets.model3dUrl}}" class="entry-model"><native-model scroll-offset="{{modelScrollOffset}}" viewport-top="{{modelViewportTop}}" viewport-bottom="{{modelViewportBottom}}" id="native-{{entry.id}}" data-id="{{entry.id}}" data-url="{{entry.assets.model3dUrl}}" bindexpand="onOpenModel" src="{{entry.assets.model3dUrl}}" dark="{{appearanceTheme === 'dark'}}" /></view>
          <view class="entry-card__footer"><view class="entry-card__grid"><view class="entry-meta-row"><text class="entry-meta-label">来源语料集</text><text class="entry-meta-value">{{entry.source.datasetName}}</text></view><view wx:if="{{entry.primaryCategory}}" class="entry-meta-row"><text class="entry-meta-label">一级分类</text><text class="entry-meta-value">{{entry.primaryCategory}}</text></view><view wx:if="{{entry.secondaryCategory}}" class="entry-meta-row"><text class="entry-meta-label">二级分类</text><text class="entry-meta-value">{{entry.secondaryCategory}}</text></view></view></view>
          <view wx:if="{{entry.primaryTags.length || entry.secondaryTags.length}}" class="entry-tag-groups"><view wx:if="{{entry.primaryTags.length}}" class="scene-tags scene-tags--primary"><text wx:for="{{entry.primaryTags}}" wx:key="*this" class="scene-tag scene-tag--primary">{{item}}</text></view><view wx:if="{{entry.secondaryTags.length}}" class="scene-tags scene-tags--secondary"><text wx:for="{{entry.secondaryTags}}" wx:key="*this" class="scene-tag">{{item}}</text></view></view>
          <view wx:if="{{entry.source.licenses.length}}" class="entry-card__tags"><text wx:for="{{entry.source.licenses}}" wx:key="*this" class="entry-tag">{{item}}</text></view>
          <view class="usage-link" role="button" data-id="{{entry.id}}" bindtap="onUsageTap"><text>查看用法</text><t-icon name="arrow-right" size="28rpx" /></view>
        </view>
      </view>
      <view wx:if="{{recommendedLoading}}" class="result-hint">正在加载…</view>
      <view wx:elif="{{recommendedError}}" class="result-hint" data-part="recommended" bindtap="onLoadMore">{{recommendedError}}</view>
      <view wx:if="{{primaryStatus === 'error'}}" class="result-hint" bindtap="onRetry">精准匹配暂时无法加载，点击重试</view>
      <view wx:if="{{semanticStatus === 'error'}}" class="result-hint" bindtap="onSemanticRetry">{{semanticLoading ? '正在重试…' : '相关内容暂时无法加载，点击重试'}}</view>
      <view wx:elif="{{semanticStatus === 'fallback'}}" class="result-hint">当前展示降级检索结果</view>
    </block>
    <view class="result-bottom-space"></view>
  </scroll-view>

  <app-tab-bar appearance-style="{{appearanceStyle}}" navigate-on-active="{{true}}" />
</view>
