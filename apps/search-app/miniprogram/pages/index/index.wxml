<view style="{{appearanceStyle}}" class="page ds-page">
  <scroll-view class="home-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="home-content">
      <view class="brand"><text class="brand__title">粤语随手查</text><text class="brand__subtitle">CANTONESE, EVERY DAY</text></view>
      <view class="search-glow"><view class="search-shell"><t-icon name="search" size="34rpx" color="var(--ds-outline)" /><input class="search-native" value="{{keyword}}" placeholder="输入汉字、粤拼或日常短句..." placeholder-class="search-placeholder" bindinput="onSearchChange" bindconfirm="onSearchSubmit" confirm-type="search" /><button class="search-submit" bindtap="onSearchSubmit">搜索</button></view></view>
      <view class="history-head"><view class="section-title section-title--small"><t-icon name="history" size="30rpx" color="var(--ds-outline)" /><text>最近查过</text></view><button class="clear-history" bindtap="onClearHistory">清空</button></view>
      <scroll-view class="history-scroll" scroll-x show-scrollbar="{{false}}"><view class="history-list"><button wx:for="{{history}}" wx:key="word" class="history-chip" data-word="{{item.word}}" bindtap="onHotWordTap"><text>{{item.word}}</text><text wx:if="{{item.phonetic}}" class="history-phonetic">{{item.phonetic}}</text></button><text wx:if="{{!history.length}}" class="history-empty">还没有查询记录，试试「唔该」</text></view></scroll-view>
      <view class="section-title scenes-title"><t-icon name="compass" size="34rpx" color="var(--ds-home-blue)" /><text>常用场景</text><text class="scene-demo-label">示例练习</text></view>
      <view class="scenes"><button wx:for="{{scenes}}" wx:key="id" class="scene-card" data-scene="{{item.id}}" bindtap="onSceneTap"><view class="scene-icon scene-icon--{{item.tone}}"><t-icon name="{{item.icon}}" size="36rpx" /></view><text>{{item.scene}}</text></button></view>
      <button wx:if="{{sceneError}}" class="scene-empty" bindtap="onSceneRetry">{{sceneError}} · 点击继续</button>
      <view class="daily-card"><view class="daily-heading"><view class="daily-mark"></view><text>今日一句</text><text class="daily-badge">高频俗语</text></view><view class="daily-main"><view><text class="daily-phonetic">dak1 haan4 jam2 caa4</text><text class="daily-word">得闲饮茶</text></view><button class="audio-button" aria-label="播放得闲饮茶发音" bindtap="onDailyAudioTap"><t-icon name="sound" size="48rpx" /></button></view><view class="daily-meaning"><view class="meaning-dot"></view><text>有空一起喝茶。</text></view><view class="daily-footer"><text class="daily-note">常用于邀约或道别时的客套话</text></view></view>
    </view>
  </scroll-view>
</view>
