.home-scroll{height:calc(100vh - 112rpx - env(safe-area-inset-bottom))}.home-content{padding:44rpx 32rpx 50rpx}.brand{margin-bottom:40rpx}.brand__title{display:block;font-size:36rpx;line-height:48rpx;font-weight:700;letter-spacing:-1rpx}.brand__subtitle{display:block;margin-top:6rpx;font-size:24rpx;line-height:28rpx;letter-spacing:3rpx;color:var(--ds-outline);font-weight:600}
.history-head{display:flex;justify-content:space-between;align-items:center;margin:24rpx 0 18rpx}.section-title{display:flex;align-items:center;gap:14rpx;font-size:32rpx;font-weight:650;line-height:42rpx}.section-title--small{font-size:24rpx;color:var(--ds-text-variant)}.clear-history{padding:12rpx 0 12rpx 20rpx;color:var(--ds-outline);font-size:24rpx}.history-scroll{width:100%;white-space:nowrap}.history-list{display:flex;gap:16rpx;align-items:center;min-height:60rpx}.history-chip{flex:none;display:flex;align-items:center;gap:12rpx;background:var(--ds-home-chip);padding:12rpx 22rpx;border-radius:40rpx;font-size:24rpx;font-weight:600;white-space:nowrap;color:var(--ds-text)}.history-phonetic{color:var(--ds-home-blue);font-size:24rpx}.history-empty{font-size:24rpx;color:var(--ds-outline)}.scenes-title{margin:48rpx 0 24rpx}.scenes{display:flex;gap:20rpx}.scene-card{flex:1;min-width:0;background:var(--ds-surface);border:1rpx solid var(--ds-border);border-radius:24rpx;box-shadow:0 6rpx 14rpx var(--ds-black-4);padding:28rpx 8rpx;display:flex;flex-direction:column;align-items:center;gap:18rpx;font-size:26rpx;font-weight:600;color:var(--ds-text)}.scene-icon{width:76rpx;height:76rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--ds-home-blue);background:var(--ds-home-blue-soft)}.scene-icon--lavender{background:var(--ds-home-lavender);color:#7862df}.scene-icon--green{background:var(--ds-home-green-soft);color:var(--ds-home-green)}
.daily-card{margin-top:40rpx;padding:38rpx;border:2rpx solid var(--ds-home-border);border-radius:30rpx;background:var(--ds-surface);box-shadow:0 10rpx 36rpx var(--ds-black-4)}.daily-heading{display:flex;align-items:center;gap:16rpx;font-size:36rpx;line-height:48rpx;font-weight:700}.daily-mark{width:10rpx;height:34rpx;background:var(--ds-home-blue);border-radius:8rpx}.daily-badge{background:var(--ds-home-blue-soft);color:var(--ds-home-blue);font-size:24rpx;line-height:32rpx;padding:2rpx 14rpx;border-radius:7rpx;font-weight:600}.daily-main{display:flex;justify-content:space-between;align-items:center;margin:38rpx 0 28rpx;gap:16rpx}.daily-phonetic{display:block;color:var(--ds-home-blue);font-size:32rpx;line-height:42rpx;font-weight:600}.daily-word{display:block;font-size:36rpx;line-height:50rpx;font-weight:700;letter-spacing:-2rpx;margin-top:8rpx}.audio-button{flex:none;width:106rpx;height:106rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--ds-home-blue);color:var(--ds-home-white);box-shadow:0 8rpx 24rpx var(--ds-home-button-shadow)}.daily-meaning{display:flex;align-items:center;gap:14rpx;background:var(--ds-surface-low);padding:18rpx 26rpx;border-radius:22rpx;font-size:28rpx;font-weight:600}.meaning-dot{width:14rpx;height:14rpx;border-radius:50%;background:var(--ds-home-blue)}.daily-footer{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-top:28rpx}.daily-note{flex:1;color:var(--ds-outline);font-size:24rpx;line-height:34rpx}

.page button{margin:0;min-width:0;width:auto}.page .audio-button{width:106rpx;flex:0 0 106rpx}.daily-main>view{flex:1;min-width:0}.daily-phonetic{white-space:nowrap;font-size:28rpx}.page .scene-card{flex:1}.page .clear-history{flex:none}

.scene-empty{width:100%;padding:26rpx;border:2rpx solid var(--ds-home-border);border-radius:24rpx;background:var(--ds-surface);color:var(--ds-text-variant);font-size:26rpx;text-align:center}

.scene-skeleton { position: relative; overflow: hidden; }
.scene-skeleton__block { background: var(--ds-surface-low); }
.scene-skeleton__label { width: 104rpx; height: 36rpx; border-radius: 8rpx; }
.scene-skeleton::after { content: ''; position: absolute; inset: 0; background: linear-gradient(100deg, transparent 20%, var(--ds-surface) 50%, transparent 80%); opacity: .65; transform: translateX(-100%); animation: scene-shimmer 1.5s ease-in-out infinite; }
@keyframes scene-shimmer { to { transform: translateX(100%); } }
