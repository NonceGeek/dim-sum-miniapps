<view wx:if="{{visible}}" class="profile-popup-mask" catchtap="onClose">
  <view class="profile-popup" catchtap="onContentTap">
    <view class="profile-popup-handle"></view>
    <view class="profile-popup-header">
      <text class="profile-popup-title">问题反馈</text>
      <view class="profile-popup-close" role="button" aria-label="关闭弹框" catchtap="onClose"><t-icon name="close" size="32rpx" /></view>
    </view>
    <scroll-view class="profile-popup-body" scroll-y>
      <text class="feedback-label">请选择问题类型</text>
      <view class="feedback-types">
        <view wx:for="{{types}}" wx:key="*this" class="feedback-type {{selectedIndex === index ? 'feedback-type--active' : ''}}" data-index="{{index}}" bindtap="onTypeTap">{{item}}</view>
      </view>
      <textarea class="feedback-input" value="{{text}}" placeholder="描述问题，最多 300 字" maxlength="300" disabled="{{submitting}}" bindinput="onInput" />
    </scroll-view>
    <button class="feedback-save" disabled="{{submitting}}" loading="{{submitting}}" bindtap="onSubmit">{{submitting ? '提交中…' : '提交反馈'}}</button>
  </view>
</view>
