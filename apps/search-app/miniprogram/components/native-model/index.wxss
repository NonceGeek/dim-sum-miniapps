:host { display: block; }
.model-container { overflow: hidden; border: 1rpx solid var(--ds-border, #e5e5e5); border-radius: 24rpx; background: var(--ds-surface, #fff); }
.model-preview { position: relative; background: var(--ds-surface-low, #f6f7fa); }
.model-status { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 20rpx; padding: 32rpx; color: var(--ds-outline, #717786); font-size: 26rpx; line-height: 40rpx; text-align: center; }
.model-status--loading { pointer-events: none; }
.model-status button, .model-toolbar button { width: auto; margin: 0; padding: 8rpx 20rpx; border: 0; border-radius: 999rpx; color: var(--ds-primary, #0058bc); background: var(--ds-home-blue-soft, #eaf1ff); font-size: 24rpx; line-height: 36rpx; }
button::after { border: 0; }
.model-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 16rpx 20rpx; color: var(--ds-outline, #717786); font-size: 24rpx; line-height: 36rpx; }
